# Console (Vercel project "console") - every variable, with how to make it.
# Set these in Vercel -> Project -> Settings -> Environment Variables
# (Production). Never commit real values. See DEPLOY.md for the walkthrough.

# Added automatically when you connect Neon from the Vercel Marketplace.
DATABASE_URL=

# The console's own production address. Must match exactly (no trailing slash).
BANSHO_RP_ID=bansho-console.vercel.app
BANSHO_ORIGIN=https://bansho-console.vercel.app

# One-time first-passkey bootstrap (>= 32 chars). Delete after setup.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BANSHO_SETUP_TOKEN=

# Shared secret for /api/cron/collect (>= 32 chars). Vercel's daily cron sends it automatically.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# The landing site's origin: the only origin allowed to POST /api/ingest.
BANSHO_SITE_ORIGIN=https://bansho-site.vercel.app

# Harahachi ops API. Token >= 48 chars, identical to SEKISHO_OPS_TOKEN on Harahachi.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HARAHACHI_URL=https://harahachi.vercel.app
HARAHACHI_OPS_TOKEN=

# Bus Board ops API. Token >= 48 chars, identical to MAPS_OPS_TOKEN on Render.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BUSBOARD_URL=https://busboard.onrender.com
BUSBOARD_OPS_TOKEN=

# Optional: day boundaries for "today" figures (default Asia/Kolkata).
BANSHO_TZ=Asia/Kolkata

# NEVER set in production. Local seed/dev mode only (python backend/dev_server.py sets it).
# BANSHO_DEV_SEED=
