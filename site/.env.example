# Build-time settings for the landing site (Vercel project "site").
# Any URL left empty hides its button instead of showing a broken link.
VITE_HARAHACHI_APP_URL=https://harahachi.example.vercel.app
VITE_HARAHACHI_APK_URL=
VITE_BUSBOARD_APP_URL=https://busboard.example.onrender.com
VITE_BUSBOARD_APK_URL=
# The console's origin + /api/ingest. Empty = no analytics at all.
VITE_INGEST_URL=https://bansho-console.example.vercel.app/api/ingest
